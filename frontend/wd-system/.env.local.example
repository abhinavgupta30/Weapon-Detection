# URL of the FastAPI + YOLOv8 backend running on your other laptop.
# Find that machine's LAN IP (e.g. `ipconfig` on Windows / `ifconfig` or
# `ip addr` on Mac/Linux) and make sure both machines are on the same
# network, then point this at it.
#
# Example: NEXT_PUBLIC_API_URL=http://192.168.1.42:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
